{
  "name": "@phantom/openapi-wallet-service",
  "version": "0.1.15",
  "description": "TypeScript client for the Phantom Wallet Service API. Generated from the OpenAPI spec.",
  "author": "Phantom <support@phantom.app>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phantom/openapi-wallet-service.git"
  },
  "keywords": [
    "phantom",
    "wallet",
    "axios",
    "typescript",
    "openapi-client",
    "openapi-generator"
  ],
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "api",
    "model",
    "docs",
    "*.ts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "regenerate": "node ./combine-and-generate.js"
  },
  "dependencies": {
    "axios": "^1.12.2"
  },
  "devDependencies": {
    "@types/node": "12.11.5 - 12.20.42",
    "js-yaml": "^4.1.0",
    "prettier": "^3.0.0",
    "typescript": "^4.0 || ^5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
